  "entry": "python3 -m qcc_copilot <command> [--input req.json]",
  "skill": "src/qcc_copilot/skill/SKILL.md",
  "verification": {
    "unit_tests": "76 (python -m unittest discover -s tests -t .)",
    "acceptance": "docs/acceptance-report.md (E01–E12)",
